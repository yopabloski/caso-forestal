rules_version = '2';

// Cada curso es un perímetro completo. El único dato global es el índice de
// códigos, necesario para llegar al curso correcto sin enumerar cursos.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/fcsAdmins/$(request.auth.uid)); }
    function correoUdd(c) { return c is string && c.matches('^[a-z0-9._%+-]+@udd[.]cl$'); }
    function rutValido(r) { return r is string && r.matches('^[0-9]{7,8}-[0-9K]$'); }
    function indice(codigo, curso, aplicacion) {
      return exists(/databases/$(database)/documents/fcsIndiceCodigos/$(codigo))
        && get(/databases/$(database)/documents/fcsIndiceCodigos/$(codigo)).data.curso == curso
        && get(/databases/$(database)/documents/fcsIndiceCodigos/$(codigo)).data.aplicacion == aplicacion;
    }
    function miembro(curso, correo) {
      return signedIn() && exists(/databases/$(database)/documents/fcsCursos/$(curso)/participantes/$(correo))
        && request.auth.uid in get(/databases/$(database)/documents/fcsCursos/$(curso)/participantes/$(correo)).data.uids;
    }
    function consentimientoValido(c) { return c is map && c.a1 is bool && c.a2 is bool && c.a3 is bool && c.a4 is bool && c.a5 is bool && c.version is string; }

    match /fcsAdmins/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list: if admin(); allow write: if false; }
    match /fcsIndiceCodigos/{codigo} { allow get: if signedIn(); allow list, write: if admin(); }
    match /fcsCursos/{curso} {
      allow get, list, create, update, delete: if admin();
      match /config/{doc} { allow get: if signedIn(); allow list, write: if admin(); }
      match /codigos/{codigo} { allow get: if signedIn(); allow list, write: if admin(); }
      match /privado/{doc} { allow read, write: if admin(); }
      match /lista/{correo} { allow get: if admin() || miembro(curso, correo); allow list, write: if admin(); }
      match /participantes/{correo} {
        allow get: if admin() || miembro(curso, correo);
        allow list, delete: if admin();
        allow create: if signedIn() && correoUdd(correo) && request.resource.data.correo == correo
          && request.resource.data.rut is string && rutValido(request.resource.data.rut)
          && request.resource.data.uids == [request.auth.uid]
          && exists(/databases/$(database)/documents/fcsCursos/$(curso)/lista/$(correo))
          && indice(request.resource.data.codigo, curso, get(/databases/$(database)/documents/fcsIndiceCodigos/$(request.resource.data.codigo)).data.aplicacion);
        allow update: if admin() || (miembro(curso, correo)
          && request.resource.data.correo == resource.data.correo && request.resource.data.rut == resource.data.rut
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codigo', 'ultimoIngreso', 'consentimiento', 'historialConsentimiento'])
          && (!('consentimiento' in request.resource.data) || consentimientoValido(request.resource.data.consentimiento)));
        match /respuestas/{aplicacion} {
          allow get, list: if admin() || miembro(curso, correo);
          allow create: if admin() || (miembro(curso, correo)
            && request.resource.data.aplicacion == aplicacion && indice(request.resource.data.codigo, curso, aplicacion)
            && get(/databases/$(database)/documents/fcsCursos/$(curso)/lista/$(correo)).data.equipo == request.resource.data.equipo
            && get(/databases/$(database)/documents/fcsCursos/$(curso)/config/sitio).data.aplicaciones[aplicacion].estado == 'abierta');
          allow update: if admin() || (miembro(curso, correo)
            && resource.data.estado != 'enviado' && request.resource.data.aplicacion == aplicacion
            && indice(request.resource.data.codigo, curso, aplicacion)
            && get(/databases/$(database)/documents/fcsCursos/$(curso)/lista/$(correo)).data.equipo == request.resource.data.equipo
            && get(/databases/$(database)/documents/fcsCursos/$(curso)/config/sitio).data.aplicaciones[aplicacion].estado == 'abierta');
          allow delete: if admin();
        }
      }
      match /verificaciones/{id} { allow read, write: if admin(); }
    }
  }
}
